# Copy to .env (git-ignored) or set as environment variables.

# Mapbox access token; leave empty to run without the Mapbox comparison.
MAPBOX_ACCESS_TOKEN=
# Map Matching profile: "mapbox/driving" (Mapbox map data) or a custom routing account,
# e.g. "<account>.zenrin-premium/driving" (ZENRIN data for Japan).
MAPBOX_PROFILE=mapbox/driving
# Search radius per transmitted coordinate in metres (Mapbox allows up to 50).
MAPBOX_RADIUS=20

# Valhalla server for drawing routes in the split view (default: the public FOSSGIS server,
# fair use - responses are cached in output/.cache/valhalla). Set empty to disable routing.
VALHALLA_URL=https://valhalla1.openstreetmap.de
